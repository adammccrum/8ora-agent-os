{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "8ora-agent-os",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "8ora-agent-os",
      "database_id": "dea5f56c-3636-494a-9c2a-6a90fd32a078",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "WORKERS_AI_FREE_PLAN": "true"
  }
}
